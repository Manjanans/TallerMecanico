<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                  <a class="nav-link" aria-current="page" href="/">Clientes</a>
                  <a class="nav-link" href="/ver_horas">Ver Horas</a>
                  <a class="nav-link" href="/ver_empleados">Empleados</a>
                  <a class="nav-link" href="/ver_productos">Productos</a>
                  <a class="nav-link" href="/venta">Venta</a>
                  <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle active" href="/pedidos" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                      aria-expanded="false">
                      Pedidos
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                      <li><a class="dropdown-item" href="/ag_pedido">Agregar Pedido</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </nav>
    </header>
    <section>
        <div class="container">
            <div class="row">
                <div class="col-4 form-floating pt-3">
                    <select class="form-select" name="provSelect" id="provSelect" style="height: 1rem;">
                        <option value="">Selecciona un proveedor:</option>
                        <% proveedores.forEach(prov => { %>
                            <option value=" <%= prov.NUM_PROV %> "><%= prov.NOMBRE_PROV %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-4 form-floating pt-3">
                    <select name="" id="prodsProv" class="form-control">
                        <option value="">Selecciona el Producto:</option>
                    </select>
                </div>
                <div class="col-4">
                    <label for="" class="form-control">Ingresa el Código del Producto</label>
                    <input type="number" id="idProd" class="form-control">
                </div>
            </div>
            <div class="row pt-4">
                <div class="container col-2 form-floating mr-3 pt-2">
                    <blockquote class="blockquote">
                        <p id="testo" hidden>Valor: <span id="valor"></span></p>
                    </blockquote>
                </div>
                <div class="col-8" id="label" hidden>
                    <label for="" class="form-control">Ingresa la Cantidad:</label>
                    <input id ="quantity" class="form-control" type="number" placeholder="Ingresa la cantidad aquí" aria-label="Cantidad">
                </div>
            </div>   
        </div>       
        <div class="container pt-3 d-flex text-center col-6 justify-content-center">
            <button class="btn btn-success" id="agregar" hidden>Añadir <span id="type"></span> </button>
        </div>
    
        <div class="container d-flex text-center col-6 justify-content-center" style="padding-top: 2%; padding-bottom: 2%;">
            <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Num Producto</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Costo</th>
                    <th scope="col">Subtotal</th>
                  </tr>
                </thead>
                <tbody>  
                </tbody>
            </table>
        </div>
        
        <div class="container pt-3 d-flex text-center col-10 justify-content-center" >
            <div class="row">
                <div class="container col-8 mr-3">
                    <select name="" id="empleados" class="form-control" hidden>
                        <option value="">Ingresa el Empleado:</option>
                    </select>
                </div>
                <div class="col-4">
                    <button class="btn btn-primary" id="finalizar" hidden>Finalizar Venta</button>
                </div>
            </div>
        </div>


        <div class="modal" tabindex="-1" role="dialog" id="success">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">¡Pedido Realizado Exitosamente!</h5>
                    </div>
                    <div class="modal-body" id="cuerpo">
                        Serás redirigido a los pedidos en 1 segundo.
                    </div>               
                </div>
            </div>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script defer src="/Javascript/configuraPedido.js"></script>
</body>
</html>