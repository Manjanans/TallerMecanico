<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>servicios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" 
        crossorigin="anonymous">
        <script src="/JavaScript/imageLoader.js"></script>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand" href="/ver_servicios">Servicios</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
              <a class="nav-link active" aria-current="page" href="/">Clientes</a>
              <a class="nav-link" href="/ver_horas">Ver Horas</a>
              <a class="nav-link" href="/ver_empleados">Empleados</a>
              <div class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="/ver_productos" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                  aria-expanded="false">
                  Productos
                </a>
                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                  <li><a class="dropdown-item" href="/ag_productos">Agregar</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </nav>
  </header>
  <div class="container d-flex text-center col-6 justify-content-center" style="padding-top: 2%; padding-bottom: 2%;">
    <table class="table border border-primary">
        <thead>
          <tr>
            <th scope="col">SKU Producto</th>
            <th scope="col">Provedor</th>
            <th scope="col">tipo de producto</th>
            <th scope="col">Nombre producto</th>
            <th scope="col">Stock</th>
            <th scope="col">Costo producto</th>
            <th scope="col">IMAGEN</th>
            <th scope="col">Eliminar Producto</th>
            <th scope="col">Editar Producto</th>
          </tr>
        </thead>
        <tbody>
          <% PRODUCTO.forEach(PRODUCTOItem => { %>
            <tr>
              <th scope="row"><%= PRODUCTOItem.ID_PRODUCTO %></th>
              <td><%= PRODUCTOItem.ID_PROV %></td>
              <td><%= PRODUCTOItem.ID_TIPO_PROD %></td>
              <td><%= PRODUCTOItem.NOMPROD %></td>
              <td><%= PRODUCTOItem.STOCK %></td>
              <td><%= PRODUCTOItem.COSTO_PROD %></td>
              <td><img src="/Images/<%= PRODUCTOItem.IMAGEN %>" alt="<%= PRODUCTOItem.IMAGEN %>" class="img-fluid" style="width: 15%; height: 15%;"></td>
              <td>
                <form action="/eli_productos/<%= PRODUCTOItem.ID_PRODUCTO %>" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar el servicio <%= PRODUCTOItem.ID_PRODUCTO %>?');">
                  <button type="submit" class="btn btn-danger" >Eliminar Producto</button>
                </form>
              </td>
              <td>
                <form action="/edi_productos/<%= PRODUCTOItem.ID_PRODUCTO %>" method="get" enctype="multipart/form-data" onsubmit="return confirm('¿Estás seguro de que deseas editar el producto <%= PRODUCTOItem.ID_PRODUCTO %>?');">
                  <button type="submit" class="btn btn-primary">Editar Producto</button>
                </form>
                
              </td>
            </tr>
          <% }); %>
          
        </tbody>
    </table>
</div> 
    
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>