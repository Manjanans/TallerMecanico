<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Formulario de Servicio</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
</head>

<body>
  <header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand" href="/ver_servicios">Servicios</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
              <a class="nav-link" aria-current="page" href="/">Clientes</a>
              <a class="nav-link" href="/ver_horas">Ver Horas</a>
              <a class="nav-link" href="/ver_empleados">Empleados</a>
              <div class="nav-item dropdown">
                <a class="nav-link dropdown-toggle active" href="/ver_productos" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                  aria-expanded="false">
                  Productos
                </a>
                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                  <li><a class="dropdown-item" href="/ag_productos">Agregar</a></li>
                </ul>
              </div>
              <a class="nav-link" href="/venta">Venta</a>
              <a class="nav-link" href="/pedidos">Pedidos</a>
              <a class="nav-link" href="/ver_proveedores">Proveedores</a>
              <a class="nav-link" href="/analisis" data-bs-toggle="modal" data-bs-target="#exampleModal">Ver informe</a>
            </div>
          </div>
        </div>
      </nav>
  </header>
  <form action="/analisis" method="post">
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Seleccione rango de fechas para el informe</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="fechaInicio" class="form-label">Fecha de Inicio:</label>
                        <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" required>
                    </div>

                    <div class="mb-3">
                        <label for="fechaFin" class="form-label">Fecha de Fin:</label>
                        <input type="date" class="form-control" id="fechaFin" name="fechaFin" required>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Seleccionar fechas</button>
                </div>
            </div>
        </div>
    </div>
</form>

  <div class="container mt-4">
    <form action="/valid_productos" method="post" enctype="multipart/form-data">
      <div class="card">
        <div class="card-body">
          <h2 class="card-title text-center">Formulario de Producto</h2>
  
          <!-- Información del Producto -->
          <div class="mb-3">
            <label for="tipoProvedor" class="form-label">Provedor:</label>
            <select class="form-select" id="tipoProvedor" name="tipoProvedor">
              <option value="">Selecciona un Proveedor:</option>
              <% provedor.forEach(tp_provedor => { %>
                <option value="<%= tp_provedor.ID_PROV %>">
                  <%= tp_provedor.NOMPROV %>
                </option>
              <% }); %>
            </select>
          </div>
  
          <div class="mb-3">
            <label for="tipoProducto" class="form-label">Producto:</label>
            <select class="form-select" id="tipoProducto" name="tipoProducto">
              <option value="">Selecciona un Tipo de Producto:</option>
              <% tp_producto.forEach(tp_producto => { %>
                <option value="<%= tp_producto.ID_TIPO_PROD %>">
                  <%= tp_producto.DESCRIPCION %>
                </option>
              <% }); %>
            </select>
          </div>
  
          <div class="mb-3">
            <label for="nombreProducto" class="form-label">Nombre del Producto:</label>
            <input type="text" class="form-control" id="nombreProducto" name="nombreProducto" >
          </div>
  
          <div class="mb-3">
            <label for="stockProducto" class="form-label">Stock:</label>
            <input type="text" class="form-control" id="stockProducto" name="stockProducto" >
          </div>
  
          <div class="mb-3">
            <label for="costoProducto" class="form-label">Costo del Producto:</label>
            <input type="text" class="form-control" id="costoProducto" name="costoProducto" >
          </div>
          <div class="mb-3">
            <label for="imagen" class="form-label">Subir Imagen:</label>
            <input type="file" class="form-control" id="imagen" name="imagen">
          </div>
          <button type="submit" class="btn btn-primary">Enviar</button>
        </div>
      </div>
    </form>
  </div>
  
  

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>

</body>

</html>