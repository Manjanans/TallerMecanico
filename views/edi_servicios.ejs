<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Formulario de Servicio</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
      <a class="navbar-brand" href="/ver_servicios">Servicios</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link active" aria-current="page" href="/">Clientes</a>
          <a class="nav-link" href="/ver_horas">Ver Horas</a>
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              Opciones
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="/ag_servicios">Agregar</a></li>
              <li><a class="dropdown-item" href="#">Eliminar</a></li>
              <li><a class="dropdown-item" href="#">Editar</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <form action="/updatearServicios/" method="post" enctype="multipart/form-data" onsubmit="return confirm('¿Estás seguro de que deseas editar el servicio <%= servicio.ID_SERV %>?');">
      <div class="card">
          <div class="card-body">
              <h2 class="card-title text-center">Formulario de Edición de Servicio</h2>
              
              <div class="mb-3">
                <select class="form-select" id="idServicio" name="idServicio">
                  <option value="<%= servicio.ID_SERV %>"><%= servicio.ID_SERV %></option>
                </select>
              </div>
  
              <div class="mb-3">
                  <label for="tipoServicio" class="form-label">ID Tipo de Servicio:</label>
                  <select class="form-select" id="tipoServicio" name="tipoServicio">
                    <option value="<%= TP_SERVICIO.ID_TIPO_SERV %>"
                      <% if (TP_SERVICIO.ID_TIPO_SERV === servicio.ID_TIPO_SERV) { %> selected <% } %>>
                      <%= TP_SERVICIO.DESCRIPCION %>
                    </option>
                  </select>
              </div>
  
              <div class="mb-3">
                  <label for="nombreServicio" class="form-label">Nombre de Servicio:</label>
                  <input type="text" class="form-control" id="nombreServicio" name="nombreServicio"
                      value="<%= servicio.NOMSERV %>" required>
              </div>
  
              <div class="mb-3">
                  <label for="valorServicio" class="form-label">Valor:</label>
                  <input type="number" class="form-control" id="valorServicio" name="valorServicio"
                      value="<%= servicio.VALOR %>" required>
              </div>
  
              <div class="mb-3">
                  <label for="imagenServicio" class="form-label">Subir Nueva Imagen:</label>
                  <input type="file" class="form-control" id="imagenServicio" name="imagenServicio">
              </div>
  
              <button type="submit" class="btn btn-primary">Guardar Cambios</button>
          </div>
      </div>
  </form>
    
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>

</body>

</html>