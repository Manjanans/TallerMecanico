<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>servicios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" 
        crossorigin="anonymous">
        <script src="/JavaScript/imageLoader.js"></script>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container-fluid">
        <div class="nav-item dropdown">
          <a class="nav-link navbar-brand dropdown-toggle" href="/ver_servicios" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
            aria-expanded="false">
            Servicios
          </a>
          <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            <li><a class="dropdown-item" href="/ag_servicios">Agregar</a></li>
            <li><a class="dropdown-item" href="#">Editar</a></li>
          </ul>
        </div>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
          aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
            <a class="nav-link active" aria-current="page" href="/">Clientes</a>
            <a class="nav-link" href="/ver_horas">Ver Horas</a>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <div class="container d-flex text-center col-6 justify-content-center" style="padding-top: 2%; padding-bottom: 2%;">
    <table class="table border border-primary">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">ID tipo de servicio</th>
            <th scope="col">Nombre de servicio</th>
            <th scope="col">valor de servicio</th>
            <th scope="col">IMAGEN</th>
            <th scope="col">Eliminar Servicio</th>
            <th scope="col">Editar Servicio</th>
          </tr>
        </thead>
        <tbody>
          <% servicio.forEach(servicioItem => { %>
            <tr>
              <th scope="row"><%= servicioItem.ID_SERV %></th>
              <td><%= servicioItem.ID_TIPO_SERV %></td>
              <td><%= servicioItem.NOMSERV %></td>
              <td><%= servicioItem.VALOR %></td>
              <td><img src="/Images/<%= servicioItem.IMAGEN %>.jpg" alt="<%= servicioItem.IMAGEN %>" class="img-fluid" style="width: 15%; height: 15%;"></td>
              <td>
                <form action="/eli_servicios/<%= servicioItem.ID_SERV %>" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar el servicio <%= servicioItem.ID_SERV %>?');">
                  <button type="submit" class="btn btn-danger" >Eliminar Servicio</button>
                </form>
              </td>
              <td>
                <form action="/edi_servicios/<%= servicioItem.ID_SERV %>" method="post" onsubmit="return confirm('¿Estás seguro de que deseas editar el servicio <%= servicioItem.ID_SERV %>?');">
                  <button type="submit" class="btn btn-warning">Editar Servicio</button>
                </form>
              </td>
            </tr>
          <% }); %>
          
        </tbody>
    </table>
</div> 
    
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>