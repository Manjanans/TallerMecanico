<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Horas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                    <a class="nav-link" aria-current="page" href="/">Clientes</a>
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle active" href="/ver_horas" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                          aria-expanded="false">
                          Ver Horas
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                          <li><a class="dropdown-item" href="/adm_horas">Administrar Horas</a></li>
                        </ul>
                      </div>
                    <a class="nav-link" href="/ver_empleados">Empleados</a>
                    <a class="nav-link" href="/ver_productos">Productos</a>
                    <a class="nav-link" href="/venta">Venta</a>
                    <a class="nav-link" href="/pedidos">Pedidos</a>
                    <a class="nav-link" href="/ver_proveedores">Proveedores</a>
                </div>
              </div>
            </div>
          </nav>
    </header>

    <section>
        <div class="container pt-2 pb-2 d-flex text-center col-6 justify-content-center">
            <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Número de Hora</th>
                    <th scope="col">Número de Cliente</th>
                    <th scope="col">Rut del Cliente</th>
                    <th scope="col">Nombre Completo del Cliente</th>
                    <th scope="col">Fecha de Inicio</th>
                    <th scope="col">Hora de Inicio</th>
                  </tr>
                </thead>
                <tbody>
                  <% horas.forEach(hora => { %>
                    <tr>
                      <th scope="row"><%= hora.NUMHORA %></th>
                      <td><%= hora.NUMCLIENTE %></td>
                      <td><%= hora.NCLI %></td>
                      <td><%= hora.RCLI %></td>
                      <td><%= hora.DINICIO.getDate() %>/<%= hora.DINICIO.getMonth()+1 %>/<%= hora.DINICIO.getFullYear() %></td>
                      <td><%= hora.TINICIO %></td>
                      <td>
                        <button type="button" class="btn btn-danger" id="btnLiberar" value="<%= hora.NUMHORA %>">Liberar Hora</button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
            </table>
        </div> 
    </section>

    <div class="modal" tabindex="-1" role="dialog" id="custom-alert-modal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">¿Estás seguro de liberar la hora?</h5>
                </div>
                <div class="modal-body" id="cuerpo">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="custom-alert-cancel-btn">Cancel</button>
                    <button type="button" class="btn btn-primary" id="custom-alert-ok-btn">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="success">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">¡Hora Liberada Exitosamente!</h5>
                </div>
                <div class="modal-body" id="cuerpo">
                    Serás redirigido al index en 1 segundo.
                </div>               
            </div>
        </div>
    </div>

    
    
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.10.2/fullcalendar.min.js"></script>
    <script src="/Javascript/admHora.js"></script>
</body>
</html>