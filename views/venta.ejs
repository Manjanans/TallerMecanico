<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Venta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                  <a class="nav-link" aria-current="page" href="/">Clientes</a>
                  <a class="nav-link" href="/ver_horas">Ver Horas</a>
                  <a class="nav-link" href="/ver_empleados">Empleados</a>
                  <a class="nav-link" href="/ver_productos">Productos</a>
                  <a class="nav-link active" href="/venta">Venta</a>
                </div>
              </div>
            </div>
          </nav>
    </header>

    <section>
        <div class="container">
            <div class="row">
                <div class="col-3 form-floating pt-3">
                    <select class="form-select" name="horaSelect" id="horaSelect" style="height: 1rem;">
                        <option value="">Selecciona una hora:</option>
                        <% horas.forEach(hora => { %>
                            <option value=" <%= hora.NUM_HORA %> "><%= hora.D_INICIO.getDate() %>/<%= hora.D_INICIO.getMonth() %>/<%= hora.D_INICIO.getFullYear() %> - <%= hora.T_INICIO %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-3">
                    <p>Id Cliente: </p>
                    <input class="form-control" type="text" id="idCliente" disabled>
                </div>
                <div class="col-3">
                    <p>Nombre Cliente: </p>
                    <input type="text" id="nomCli" class="form-control" disabled>
                </div>
                <div class="col-3">
                    <p>Rut del Cliente: </p>
                    <input type="text" id="rutCli" class="form-control" disabled>
                </div>
            </div>   
        </div>
        <div class="container pt-4" id="agregasion" hidden>
            <div class="row">
                <div class="d-flex justify-content-center">
                    <div class="col-4" style="padding-right: 2%;">
                        <select name="" id="tipo_venta" class="form-control">
                            <option value="">Selecciona el Tipo de Venta:</option>
                            <option value="Servicio">Venta de Servicio</option>
                            <option value="Producto">Venta de Producto</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="container pt-4" id="venta" hidden>
            <div class="row">
                <div class="d-flex justify-content-center">
                    <div class="col-3">
                        <select name="" id="paso-final" class="form-control"> 
                        </select>
                    </div>
                    <div class="container col-3 pl-2">
                        <label for="" class="form-control">Ingresa el Código del <span id="type"></span></label>
                        <input type="number" id="idProdServ" class="form-control"> 
                    </div>
                    <div class="container col-3 pl-2">
                        <p id="testo" hidden>Valor: <span id="valor"></span></p>
                    </div>
                    <div class="container col-3 pl-2">
                        <label for="" class="form-control" id="label" hidden>Ingresa la Cantidad:</label>
                        <input id ="quantity" class="form-control" type="number" placeholder="Ingresa la cantidad aquí" aria-label="Cantidad" hidden>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="container pt-3 d-flex text-center col-6 justify-content-center">
            <button class="btn btn-success" id="agregar" hidden>Añadir <span id="type"></span> </button>
        </div>
    
        <div class="container d-flex text-center col-6 justify-content-center" style="padding-top: 2%; padding-bottom: 2%;">
            <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Tipo</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Subtotal</th>
                  </tr>
                </thead>
                <tbody>  
                </tbody>
            </table>
        </div>
        
        <div class="container pt-3 d-flex text-center col-6 justify-content-center" >
            <div class="container row mr-3" id="end" hidden>
                <select name="" id="tipo_comp" class="form-control" style="width: 95%;">
                    <option value="">Selecciona el Tipo de Comprobante:</option>
                </select>
            </div>
            <button class="btn btn-primary" id="finalizar" hidden>Finalizar Venta</button>
        </div>
    </section>
    
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script defer src="/Javascript/ventaJS.js"></script>
</body>
</html>