<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horas</title>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    
    <select name="horas" id="horas">
        <option value="">Selecciona el día</option>
        <% dates.forEach(date=>{ %>
            <option value="<%= date %>"><%= date %></option>
        <% }); %>
    </select>

    <br>

    <select id="horaSelect">
    </select>


    <table class="table border border-primary" id="horaTable">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">FECHA INICIO</th>
                <th scope="col">HORA INICIO</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script>
        $(document).ready(function() {
            // Set up an event listener for the selection change
            $('#horas').on('change', function() {
                // Get the selected date
                const selectedDate = $(this).val();
                const horas = <%- JSON.stringify(horas) %>;
    
                // Filter the horas array based on the selected date
                const filteredHoras = horas.filter(hora => hora.FECHA_INI == selectedDate);
    
                // Clear the existing table rows
                $('.horaRow').remove();
                $('#horaSelect').children().remove();
    
                // Append new rows based on the filtered array
                filteredHoras.forEach(hora => {
                    $('#horaSelect').append(`
                        <option value="${hora.ID_HORA}">${hora.HORA_INI}</option>
                    `);
                });
            });
        });
    </script>
</body>
</html>