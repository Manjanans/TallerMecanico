<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                  <a class="nav-link" aria-current="page" href="/">Clientes</a>
                  <a class="nav-link" href="/ver_horas">Ver Horas</a>
                  <a class="nav-link" href="/ver_empleados">Empleados</a>
                  <a class="nav-link" href="/ver_productos">Productos</a>
                  <a class="nav-link" href="/venta">Venta</a>
                  <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle active" href="/pedidos" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                      aria-expanded="false">
                      Pedidos
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                      <li><a class="dropdown-item" href="/ag_pedido">Agregar Pedido</a></li>
                    </ul>
                  </div>
                  <a class="nav-link" href="/ver_proveedores">Proveedores</a>
                  <a class="nav-link" href="/analisis" data-bs-toggle="modal" data-bs-target="#exampleModal">Ver informe</a>
                </div>
              </div>
            </div>
          </nav>
    </header>
    <form action="/analisis" method="post">
      <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
          <div class="modal-dialog">
              <div class="modal-content">
                  <div class="modal-header">
                      <h1 class="modal-title fs-5" id="exampleModalLabel">Seleccione rango de fechas para el informe</h1>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
  
                  <div class="modal-body">
                      <div class="mb-3">
                          <label for="fechaInicio" class="form-label">Fecha de Inicio:</label>
                          <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" required>
                      </div>
  
                      <div class="mb-3">
                          <label for="fechaFin" class="form-label">Fecha de Fin:</label>
                          <input type="date" class="form-control" id="fechaFin" name="fechaFin" required>
                      </div>
                  </div>
                  
                  <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                      <button type="submit" class="btn btn-primary">Seleccionar fechas</button>
                  </div>
              </div>
          </div>
      </div>
  </form>
    <section>
        <div class="container pt-2 pb-2 d-flex text-center col-6 justify-content-center">
            <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Número de Órden de Compra</th>
                    <th scope="col">Número de Empleado (Realiza Pedido)</th>
                    <th scope="col">Nombre de Empleado (Realiza Pedido)</th>
                    <th scope="col">Fecha de Realización</th>
                    <th scope="col">Valor Total</th>
                    <th scope="col">¿Recepcionado?</th>
                    <th scope="col">Fecha de Recepción</th>
                    <th scope="col">Número de Empleado (Acepta Pedido)</th>
                    <th scope="col">Nombre de Empleado (Acepta Pedido)</th>
                    <th scope="col">Recepcionar Pedido</th>
                    <th scope="col">Ver Detalle Pedido</th>
                  </tr>
                </thead>
                <tbody>
                  <% pedidos.forEach(pedido => { %>
                    <tr>
                      <th scope="row"><%= pedido.NUM_PEDIDO %></th>
                      <td><%= pedido.HACE_PEDIDO %></td>
                      <td><%= pedido.NOMBRE_REALIZA %></td>
                      <td><%= pedido.FECHA_REALIZA.getDate() %>/<%= pedido.FECHA_REALIZA.getMonth()+1 %>/<%= pedido.FECHA_REALIZA.getFullYear() %></td>
                      <td><%= pedido.VALOR %></td>
                      <% if(pedido.ENTREGADO != null){ %>
                        <td>Recepcionado</td>
                        <td><%= pedido.FECHA_ENTREGA.getDate() %>/<%= pedido.FECHA_ENTREGA.getMonth()+1 %>/<%= pedido.FECHA_ENTREGA.getFullYear() %></td>
                        <td><%= pedido.ACEPTA_PEDIDO %></td>
                        <td><%= pedido.NOMBRE_ACEPTA %></td>
                        <td>
                          <button type="button" class="btn btn-danger" id="btnRecepcion" value="<%= pedido.NUM_PEDIDO %>" disabled>Recepcionar Pedido</button>
                        </td>
                      <% }else{ %>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                        <td>
                          <button type="button" class="btn btn-success" id="btnRecepcion" value="<%= pedido.NUM_PEDIDO %>">Recepcionar Pedido</button>
                        </td>
                      <% } %>
                        <td>
                          <button type="button" class="btn btn-primary" id="btnDetalle" value="<%= pedido.NUM_PEDIDO %>">Ver Pedido</button>
                        </td>
                    </tr>
                  <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <div class="modal" tabindex="-1" role="dialog" id="custom-alert-modal">
      <div class="modal-dialog" role="document">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title">¿Estás seguro de recepcionar el pedido?</h5>
              </div>
              <div class="modal-body" id="cuerpo">
              </div>
              <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" id="custom-alert-cancel-btn">Cancel</button>
                  <button type="button" class="btn btn-primary" id="custom-alert-ok-btn">OK</button>
              </div>
          </div>
      </div>
  </div>

  <div class="modal" tabindex="-1" role="dialog" id="empleado">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">¿Estás seguro de recepcionar el pedido?</h5>
            </div>
            <div class="modal-body" id="cuerpo">
              <select name="" id="empleados" class="form-control">
                <option value="">Ingresa el Empleado:</option>
              </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancela">Cancel</button>
                <button type="button" class="btn btn-primary" id="ok-final">OK</button>
            </div>
        </div>
    </div>
  </div>

  <div class="modal" tabindex="-1" role="dialog" id="success">
      <div class="modal-dialog" role="document">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title">¡Pedido Recepcionado Exitosamente!</h5>
              </div>
              <div class="modal-body" id="cuerpo">
                  Serás redirigido a ver pedidos en 1 segundo.
              </div>               
          </div>
      </div>
  </div>

  <div class="modal" tabindex="-1" role="dialog" id="detPedido">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del pedido</h5>
            </div>
            <div class="modal-body" id="cuerpo">
              <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Número de Producto</th>
                    <th scope="col">Nombre Producto</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Valor Unitario</th>
                    <th scope="col">Valor Total</th>
                  </tr>
                </thead>
                <tbody id="cuerpito">
                </tbody>
              </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="cerrar">Cerrar</button>
            </div>
        </div>
    </div>
  </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="/Javascript/recepcion.js"></script>
</body>
</html>