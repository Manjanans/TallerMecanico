<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
              <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                  <a class="nav-link" aria-current="page" href="/">Clientes</a>
                  <a class="nav-link" href="/ver_horas">Ver Horas</a>
                  <a class="nav-link" href="/ver_empleados">Empleados</a>
                  <a class="nav-link" href="/ver_productos">Productos</a>
                  <a class="nav-link" href="/venta">Venta</a>
                  <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle active" href="/pedidos" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                      aria-expanded="false">
                      Pedidos
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                      <li><a class="dropdown-item" href="/ag_pedido">Agregar Pedido</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </nav>
    </header>
    <section>
        <div class="container pt-2 pb-2 d-flex text-center col-6 justify-content-center">
            <table class="table border border-primary">
                <thead>
                  <tr>
                    <th scope="col">Número de Órden de Compra</th>
                    <th scope="col">Número de Empleado (Realiza Pedido)</th>
                    <th scope="col">Nombre de Empleado (Realiza Pedido)</th>
                    <th scope="col">Fecha de Realización</th>
                    <th scope="col">Valor Total</th>
                    <th scope="col">¿Recepcionado?</th>
                    <th scope="col">Fecha de Recepción</th>
                    <th scope="col">Número de Empleado (Acepta Pedido)</th>
                    <th scope="col">Nombre de Empleado (Acepta Pedido)</th>
                  </tr>
                </thead>
                <tbody>
                  <% pedidos.forEach(pedido => { %>
                    <tr>
                      <th scope="row"><%= pedido.NUM_PEDIDO %></th>
                      <td><%= pedido.HACE_PEDIDO %></td>
                      <td><%= pedido.NOMBRE_REALIZA %></td>
                      <td><%= pedido.FECHA_REALIZA.getDate() %>/<%= pedido.FECHA_REALIZA.getMonth()+1 %>/<%= pedido.FECHA_REALIZA.getFullYear() %></td>
                      <td><%= pedido.VALOR %></td>
                      <% if(pedido.ENTREGADO != null){ %>
                        <td><%= pedido.ENTREGADO %></td>
                        <td><%= pedido.FECHA_ENTREGA.getDate() %>/<%= pedido.FECHA_ENTREGA.getMonth()+1 %>/<%= pedido.FECHA_ENTREGA.getFullYear() %></td>
                        <td><%= pedido.ACEPTA_PEDIDO %></td>
                        <td><%= pedido.NOMBRE_ACEPTA %></td>
                      <% }else{ %>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                        <td>Sin Recepción</td>
                      <% } %>
                    </tr>
                  <% }); %>
                </tbody>
            </table>
        </div>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</body>
</html>