<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>servicios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" 
        crossorigin="anonymous">
        <script src="/JavaScript/imageLoader.js"></script>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container-fluid">
        <a class="navbar-brand" href="/ver_servicios">Servicios</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
          aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
            <a class="nav-link" aria-current="page" href="/">Clientes</a>
            <a class="nav-link" href="/ver_horas">Ver Horas</a>
            <div class="nav-item dropdown">
              <a class="nav-link dropdown-toggle active" href="/ver_Empleados" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Empleados
              </a>
              <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" href="/ag_empleados">Agregar</a></li>
              </ul>
            </div>
            <a class="nav-link" href="/ver_productos">Productos</a>
            <a class="nav-link" href="/venta">Venta</a>
            <a class="nav-link" href="/pedidos">Pedidos</a>
            <a class="nav-link" href="/ver_proveedores">Proveedores</a>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <div class="container d-flex text-center col-6 justify-content-center" style="padding-top: 2%; padding-bottom: 2%;">
    <table class="table border border-primary">
        <thead>
          <tr>
            <th scope="col">RUT emp</th>
            <th scope="col">Nombres</th>
            <th scope="col">apellidos</th>
            <th scope="col">Telefono</th>
            <th scope="col">Email</th>
            <th scope="col">Fecha nacimiento</th>
            <th scope="col">Direccion</th>
            <th scope="col">Tipo empleado</th>
            <th scope="col">Tipo contrato</th>
            <th scope="col">Fecha contrato</th>
            <th scope="col">Sueldo</th>
            <th scope="col">Usuario</th>
            <th scope="col">Contraseña</th>
            <th scope="col">Eliminar</th>
            <th scope="col">Editar</th>
          </tr>
        </thead>
        <tbody>
          <% EMPLEADO.forEach(EMPLEADOITEM => { %>
            <tr>
              <th scope="row"><%= EMPLEADOITEM.NUMRUN %></th>
              <td><%= EMPLEADOITEM.NOMBRES %></td>
              <td><%= EMPLEADOITEM.APELLIDOS %></td>
              <td><%= EMPLEADOITEM.NUMFONO %></td>
              <td><%= EMPLEADOITEM.EMAIL %></td>
              <td><%= EMPLEADOITEM.FECHA_NAC_FORMAT %></td>
              <td><%= EMPLEADOITEM.DIRECCION %></td>
              <td><%= EMPLEADOITEM.ID_TIPO_EMP %></td>
              <td><%= EMPLEADOITEM.ID_TIPO_CON %></td>
              <td><%= EMPLEADOITEM.FECHA_CONTRATO_FORMAT %></td>
              <td><%= EMPLEADOITEM.SUELDO %></td>
              <td><%= EMPLEADOITEM.USUARIO %></td>
              <td><%= EMPLEADOITEM.CONTRASENIA %></td>
              <td>
                <form action="/eli_empleados/<%= EMPLEADOITEM.NUMRUT %>" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar el EMPLEADO <%= EMPLEADOITEM.NUMRUT %>?');">
                  <button type="submit" class="btn btn-danger" >Eliminar</button>
                </form>
              </td>
              <td>
                <form action="/edi_empleados/<%= EMPLEADOITEM.NUMRUT %>" method="post" onsubmit="return confirm('¿Estás seguro de que deseas editar el EMPLEADO <%= EMPLEADOITEM.NUMRUT %>?');">
                  <button type="submit" class="btn btn-warning">Editar</button>
                </form>
              </td>
            </tr>
          <% }); %>
          
        </tbody>
    </table>
</div> 
    
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>